@model IEnumerable<HospitalManagementSystem.Models.Doctor>

@{
    ViewData["Title"] = "Doctor List";
}

<h2 class="my-3">Available Doctors</h2>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Doctor ID</th>
            <th>Doctor Name</th>
            <th>Specialization</th>
            <th>Experience (Years)</th>
            <th>Contact Number</th>
            <th>Base Fee (₹)</th>
            <th>Total Fee (Incl. ₹100 Fee)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var doctor in Model)
        {
            <tr>
                <td>@doctor.DoctorId</td>
                <td>@doctor.DoctorName</td>
                <td>@doctor.Specialization</td>
                <td>@doctor.Experience</td>
                <td>@doctor.ContactNumber</td>
                <td>₹@doctor.ConsultationFee</td>
                <!-- Using extension method CalculateTotalCharge()[cite: 1] -->
                <td><strong>₹@doctor.CalculateTotalCharge()</strong></td>
                <td>
                    <!-- Passing DoctorId via Query String to Details page[cite: 1] -->
                    <a asp-action="Details" asp-route-doctorId="@doctor.DoctorId" class="btn btn-info btn-sm">View Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="Posts" class="btn btn-secondary">View External Posts (Async Request)</a>
</div>